// Cloudflare Workers static site: serves this folder (index.html is the page). Every push to main redeploys.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graded-tpms-designer",
  "compatibility_date": "2026-11-17",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  "assets": { "directory": "." }
}
